generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String
  role           String    @default("CLIENT")
  otpCode        String?
  otpExpiresAt   DateTime?
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cases         Case[]
  caseMessages  CaseMessage[]
  caseDocuments CaseDocument[]
  notifications Notification[]
  aiAnalyses    AIAnalysis[]
}

model Consultation {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  snsType   String
  content   String
  status    String   @default("NEW")
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files      ConsultationFile[]
  aiAnalyses AIAnalysis[]

  case   Case?   @relation
  caseId String? @unique
}

model ConsultationFile {
  id             String       @id @default(cuid())
  fileName       String
  fileSize       Int
  mimeType       String
  data           String       // base64 encoded
  createdAt      DateTime     @default(now())

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  consultationId String
}

model Case {
  id             String   @id @default(cuid())
  clientName     String
  snsType        String
  status         String   @default("ACCEPTED")
  description    String?
  portalToken    String   @unique @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  consultationId String?       @unique

  clientUser   User?   @relation(fields: [clientUserId], references: [id])
  clientUserId String?

  timelines   CaseTimeline[]
  messages    CaseMessage[]
  documents   CaseDocument[]
  aiAnalyses  AIAnalysis[]
  invitations ClientInvitation[]
}

model CaseTimeline {
  id                String   @id @default(cuid())
  title             String
  description       String?
  date              DateTime
  isVisibleToClient Boolean  @default(true)
  createdAt         DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String
}

model CaseMessage {
  id           String   @id @default(cuid())
  content      String
  isFromClient Boolean  @default(false)
  createdAt    DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model CaseDocument {
  id                 String   @id @default(cuid())
  fileName           String
  fileUrl            String
  fileSize           Int
  uploadedBy         String
  documentType       String   @default("UPLOADED") // UPLOADED, CREATED, COURT, OPPONENT
  isSharedWithClient Boolean  @default(false)
  createdAt          DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // STATUS_CHANGE, NEW_MESSAGE, DOCUMENT_SHARED, INVITATION
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model AIAnalysis {
  id                    String   @id @default(cuid())
  defamationLikelihood  String   // HIGH, MEDIUM, LOW
  recommendedProcedure  String
  estimatedCost         String
  keyPoints             String   // JSON array
  rawResponse           String?
  isPlaceholder         Boolean  @default(false)
  createdAt             DateTime @default(now())

  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  consultationId String?

  case   Case?   @relation(fields: [caseId], references: [id])
  caseId String?

  user   User   @relation(fields: [userId], references: [id])
  userId String
}

model ClientInvitation {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  fields      String   // JSON: [{key, label, type, defaultValue?}]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
