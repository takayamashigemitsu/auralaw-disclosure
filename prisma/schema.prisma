generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  name           String
  role           String    @default("CLIENT")
  otpCode        String?
  otpExpiresAt   DateTime?
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cases             Case[]
  caseMessages      CaseMessage[]
  caseDocuments     CaseDocument[]
  notifications     Notification[]
  aiAnalyses        AIAnalysis[]
  aiOrganizeResults AIOrganizeResult[]
  assignedTasks     CaseTask[]            @relation("TaskAssignee")
  taskComments      TaskComment[]         @relation("TaskCommentAuthor")
  aiSampleRuns      AISampleRun[]         @relation("SampleRunRunner")
  aiSampleScored    AISampleRun[]         @relation("SampleRunScorer")
  releaseApprovals  ReleaseGateApproval[]
}

model Consultation {
  id             String    @id @default(cuid())
  name           String
  email          String
  phone          String?
  snsType        String
  content        String
  status         String    @default("NEW")
  memo           String?
  // ─── 同意記録（個人情報保護法・利用規約・AI利用） ───
  consentedAt    DateTime?
  consentVersion String?
  consentPrivacy Boolean   @default(false)
  consentTerms   Boolean   @default(false)
  consentAI      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  files             ConsultationFile[]
  aiAnalyses        AIAnalysis[]
  aiOrganizeResults AIOrganizeResult[]

  case Case? @relation
}

model ConsultationFile {
  id        String   @id @default(cuid())
  fileName  String
  fileSize  Int
  mimeType  String
  data      String // base64 encoded
  createdAt DateTime @default(now())

  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  consultationId String

  @@index([consultationId])
}

model Case {
  id          String   @id @default(cuid())
  clientName  String
  snsType     String
  status      String   @default("ACCEPTED")
  description String?
  portalToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  consultationId String?       @unique

  clientUser   User?   @relation(fields: [clientUserId], references: [id], onDelete: SetNull)
  clientUserId String?

  targets           CaseTarget[]
  timelines         CaseTimeline[]
  messages          CaseMessage[]
  documents         CaseDocument[]
  aiAnalyses        AIAnalysis[]
  aiOrganizeResults AIOrganizeResult[]
  invitations       ClientInvitation[]
  billings          CaseBilling[]
  tasks             CaseTask[]
}

model CaseTarget {
  id          String   @id @default(cuid())
  snsType     String // X, INSTAGRAM, FIVECH, etc.
  url         String? // 対象投稿URL
  postContent String? // 投稿内容の概要
  defendant   String? // 被告名（判明している場合）
  status      String   @default("PENDING") // PENDING, DISCLOSED, IDENTIFIED, SETTLED
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  @@index([caseId])
}

model CaseTimeline {
  id                String   @id @default(cuid())
  title             String
  description       String?
  date              DateTime
  isVisibleToClient Boolean  @default(true)
  createdAt         DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  @@index([caseId, date])
}

model CaseMessage {
  id           String   @id @default(cuid())
  content      String
  isFromClient Boolean  @default(false)
  createdAt    DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([caseId, createdAt])
}

model CaseDocument {
  id                 String   @id @default(cuid())
  fileName           String
  fileUrl            String
  fileSize           Int
  uploadedBy         String
  documentType       String   @default("UPLOADED") // UPLOADED, CREATED, COURT, OPPONENT
  isSharedWithClient Boolean  @default(false)
  createdAt          DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([caseId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String // STATUS_CHANGE, NEW_MESSAGE, DOCUMENT_SHARED, INVITATION
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, isRead, createdAt])
}

/// CAIO方針: 「AIで判断するな、AIで圧縮しろ」
/// AI整理結果（summary / facts / timeline / risk flags 等）を永続化する。
/// AIAnalysis（法的判断付き）は段階的に廃止する。
model AIOrganizeResult {
  id                 String   @id @default(cuid())
  /// プロンプトバージョン（差分比較用）例: "organize-v1"
  promptVersion      String
  /// 3行以内の要約
  summary            String
  /// string[]（最大7）
  facts              String // JSON
  /// { role, name?, handle? }[]
  parties            String // JSON
  /// { when, what, gap? }[]
  timeline           String // JSON
  /// string[]
  suggestedQuestions String // JSON
  /// RiskFlag[]（type enum + detail）
  riskFlags          String // JSON
  /// 不足情報 string[]
  missingInfo        String // JSON
  /// 生の応答（監査用）
  rawResponse        String
  /// 連打防止用の冪等キー: sha256(consultationId|caseId + normalizedContent + promptVersion)
  idempotencyKey     String?  @unique
  createdAt          DateTime @default(now())

  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  consultationId String?

  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String?

  createdByUser User   @relation(fields: [createdBy], references: [id])
  createdBy     String

  sampleRuns    AISampleRun[]

  @@index([consultationId, createdAt])
  @@index([caseId, createdAt])
  @@index([createdBy, createdAt])
}

/// A6 リリースゲート: 5サンプルに対する organizeConsultation 実行結果 + 5軸採点
model AISampleRun {
  id            String   @id @default(cuid())
  /// release-samples.ts の key（例: "x-evidence-full"）
  sampleKey     String
  /// 人間が読むラベル（実行時点のコピー）
  sampleLabel   String
  /// 実行時の promptVersion
  promptVersion String
  /// エラー時のメッセージ（成功時は null）
  errorMessage  String?

  organizeResult   AIOrganizeResult? @relation(fields: [organizeResultId], references: [id], onDelete: SetNull)
  organizeResultId String?

  // ─── 5 軸採点（1-5, null = 未採点） ───
  /// 事実正確性: 相談内容から逸脱なく事実を抽出できたか
  scoreFactAccuracy         Int?
  /// 圧縮率: ノイズを削ぎ落とせたか
  scoreCompressionRate      Int?
  /// 禁止ワード遵守: 法的判断語が出力されていないか
  scoreForbiddenCompliance  Int?
  /// 不足情報指摘力: 面談で聞くべき情報を拾えたか
  scoreMissingInfoDetection Int?
  /// 構造整合: timeline / riskFlags / parties の形が妥当か
  scoreStructureConsistency Int?
  /// 実務優先順位: ログ保存期限・証拠保全の緊急性・次アクションの明示（第6軸）
  scorePracticalPriority    Int?
  /// 採点メモ（自由記述）
  scoreNotes                String?

  scoredBy     String?
  scoredByUser User?     @relation("SampleRunScorer", fields: [scoredBy], references: [id], onDelete: SetNull)
  scoredAt     DateTime?

  runBy     String
  runByUser User   @relation("SampleRunRunner", fields: [runBy], references: [id])
  createdAt DateTime @default(now())

  @@index([sampleKey, createdAt])
  @@index([promptVersion, createdAt])
  @@index([runBy, createdAt])
}

/// A6 リリースゲート: PASS 時点のスナップショット（immutable）
/// 「どの prompt version で、誰が、どのスコアで合格判定したか」を不変記録。
/// 後日の検証可能性を担保するため、更新不可で扱う（コード上の規約）。
model ReleaseGateApproval {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  /// 承認時点の ORGANIZE_PROMPT_VERSION
  promptVersion  String
  /// "PASS" のみ保存される想定（FAIL/INCOMPLETE は作らない）
  result         String
  /// 承認時点の各サンプルのスコア（SampleScore[] を JSON 化）
  samplesJson    String
  /// 承認時点の GateEvaluation 全体（平均値・failureReasons 等）JSON
  evaluationJson String
  /// 承認者メモ
  notes          String?

  reviewer   User   @relation(fields: [reviewerId], references: [id])
  reviewerId String

  @@index([createdAt])
  @@index([promptVersion, createdAt])
}

model AIAnalysis {
  id                   String   @id @default(cuid())
  defamationLikelihood String // HIGH, MEDIUM, LOW
  recommendedProcedure String
  estimatedCost        String
  keyPoints            String // JSON array
  rawResponse          String?
  isPlaceholder        Boolean  @default(false)
  createdAt            DateTime @default(now())

  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  consultationId String?

  case   Case?   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  @@index([caseId])
  @@index([consultationId])
}

model ClientInvitation {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String
}

model CaseTask {
  id          String    @id @default(cuid())
  templateKey String? // タスクテンプレートのキー（自動生成時）
  title       String
  description String?
  category    String    @default("AUTO") // AUTO, MANUAL
  priority    String    @default("NORMAL") // URGENT, HIGH, NORMAL, LOW
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, DONE, SKIPPED
  caseStatus  String // どのステータスで生成されたか
  dueDate     DateTime
  sortOrder   Int       @default(0)
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  case       Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  assignee   User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?
  comments   TaskComment[]

  @@unique([caseId, templateKey, caseStatus])
  @@index([caseId, status])
  @@index([assigneeId, status, dueDate])
  @@index([dueDate, status])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  task   CaseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
  user   User     @relation("TaskCommentAuthor", fields: [userId], references: [id])
  userId String

  @@index([taskId, createdAt])
}

model CaseBilling {
  id                String   @id @default(cuid())
  feeId             String // fees.ts の FeeItem.id または "custom"
  label             String // 表示名（作成時にスナップショット）
  amount            Int // 金額（円）（作成時にスナップショット）
  status            String   @default("ESTIMATED") // ESTIMATED, CONFIRMED, INVOICED, PAID
  note              String?
  isVisibleToClient Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  @@index([caseId])
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  fields      String // JSON: [{key, label, type, defaultValue?}]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── 構造化ログ ───
model AppLog {
  id        String   @id @default(cuid())
  level     String // info, warn, error
  category  String // auth, db, api, ui, business
  message   String
  context   String? // JSON: エラー詳細、リクエスト情報等
  userId    String?
  path      String?
  userAgent String?
  duration  Int? // ms
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
}
